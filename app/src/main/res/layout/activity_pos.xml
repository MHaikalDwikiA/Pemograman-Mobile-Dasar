<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBarPos"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/pos_title"
            app:titleTextColor="?attr/colorOnPrimary"
            android:background="?attr/colorPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pos_subtitle"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBarcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_barcode"
            app:startIconDrawable="@android:drawable/ic_menu_camera"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBarcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/rgSimulation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbSuccess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sim_success"
                android:checked="true"
                android:paddingVertical="8dp"/>

            <RadioButton
                android:id="@+id/rbBarcodeError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sim_err_404"
                android:paddingVertical="8dp"/>

            <RadioButton
                android:id="@+id/rbNetworkTimeout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sim_err_network"
                android:paddingVertical="8dp"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnProcessPayment"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_process_payment"
            app:icon="@android:drawable/ic_menu_send" />

        <ProgressBar
            android:id="@+id/pbPosLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <!-- Card Hasil Transaksi (Receipt Style) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPosResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/pos_success_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvPosStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trx_success"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/pos_success_green"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutline"
                    android:layout_marginBottom="12dp"
                    android:alpha="0.3"/>

                <TextView
                    android:id="@+id/tvPosDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/trx_details_placeholder"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>